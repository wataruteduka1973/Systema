# Systema settings for Docker Compose (compose.yaml). Copy to .env in the project root, or create it
# with scripts/linux/create-env.sh, which fills in random secrets and sets mode 600.
# Never commit .env: it holds the Django secret key and the database password.

# production: HTTPS redirect, secure cookies and HSTS. Serve it only behind an HTTPS reverse proxy.
# development: plain HTTP on this machine for a local trial (do not expose it to the internet).
SYSTEMA_ENV=production
DJANGO_SECRET_KEY=
# Public host names and their HTTPS origins (comma separated).
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# true only when a trusted reverse proxy terminates HTTPS and sets X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=true

POSTGRES_DB=systema
POSTGRES_USER=systema
POSTGRES_PASSWORD=

# gunicorn worker processes, and where the web container is published on the host.
WEB_CONCURRENCY=3
SYSTEMA_HTTP_BIND=127.0.0.1
SYSTEMA_HTTP_PORT=8000
